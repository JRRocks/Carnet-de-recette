<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mise à jour en ligne depuis les Releases GitHub (moteur Library `maj-auto-github`). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Scan des étiquettes et des fiches papier (CameraX, OCR ML Kit embarqué). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Commandes vocales en séance, sur demande seulement (cadrage § 8). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Retour haptique d'un scan validé (moteur scan-multimode, ScanFeedback). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Minuteurs de la séance : le téléphone reste éveillé, écran éteint, jusqu'à la fin du
         dernier minuteur et de sa sonnerie (verrous bornés, cadrage § 8). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11 et plus : rendre visibles le moteur de synthèse vocale et le service de
         reconnaissance vocale du téléphone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carnet">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- L'installateur système lit l'APK téléchargé par une content:// de ce fournisseur. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
